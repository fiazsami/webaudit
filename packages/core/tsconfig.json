{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No "DOM" and no "types": ["node"]. This is CLAUDE.md hard rule 1 enforced
    // by the compiler — core cannot name `window`, `document`, `chrome`, or any
    // Node global, because those types are not in scope here.
    "lib": ["ES2023"],
    "types": [],
    // The vendored Observatory sources are JavaScript, and they have to reach
    // dist for the hosts to import. allowJs emits them; checkJs stays off
    // because their JSDoc references axios and tough-cookie types we will not
    // add to the build (docs/03, S1 result).
    "allowJs": true,
    "checkJs": false,

    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "vitest.config.ts"]
}
