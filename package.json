{
  "name": "webaudit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "scan": "node packages/cli/dist/main.js audit",
    "serve-fixture": "python3 -m http.server 8787 --directory fixtures/site",
    "build-hsts-preload": "node scripts/build-hsts-preload.mjs",
    "build-library-db": "node scripts/build-library-db.mjs",
    "build-tracker-db": "node scripts/build-tracker-db.mjs",
    "build-model-integrity": "node scripts/build-model-integrity.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@mlc-ai/web-llm": "^0.2.84",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
